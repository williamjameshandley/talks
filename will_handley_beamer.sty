\usepackage{tikz}
\usetikzlibrary{calc}
\newcommand{\av}[2][]{\left\langle #2\right\rangle_{#1}}
\newcounter{studentcount}
\newcommand{\student}[3]{
    \stepcounter{studentcount}
    \tikz[overlay,remember picture]{
        \ifnum\value{studentcount}=1
            \node[anchor=north east] (student-photo-1) at ($(current page.north east)+(0,0)$) {\includegraphics[width=0.09\textheight]{people/#1}};
            \node[anchor=north east] (student-name-1) at (student-photo-1.north west) {#2};
            \node[anchor=north east] at (student-name-1.south east) {\tiny #3};
        \else
            \node[anchor=north east] (student-photo-2) at ($(student-name-1.north west)+(-0.5em,0)$) {\includegraphics[width=0.09\textheight]{people/#1}};
            \node[anchor=north east] (student-name-2) at (student-photo-2.north west) {#2};
            \node[anchor=north east] at (student-name-2.south east) {\tiny #3};
        \fi
    }
    \ifnum\value{studentcount}=1\vspace{-0.1\textheight}\fi
}
\addtobeamertemplate{frametitle}{\setcounter{studentcount}{0}}{}

% Number slides from zero
\setcounter{framenumber}{-1}
